# Copie para .env na VPS e preencha. O .env NÃO vai para o Git.
# A chave do JWT fica no .env.secrets (veja .env.secrets.example).

# ---------- banco ----------
DATABASE_NAME=despesas
DATABASE_USER=despesas
# Senha longa e aleatória: openssl rand -base64 32
# Evite o caractere $ aqui — esta variável passa pela interpolação do Compose.
DATABASE_PASSWORD=

# ---------- defesa das rotas abertas ----------
# Tentativas por IP por minuto nos POST de /api/v1/auth/**. Acima disso: 429.
# 10 é folgado para uma pessoa e apertado para um script.
AUTH_TENTATIVAS_POR_MINUTO=10

# ---------- endereços ----------
# URL do front. Vira a base dos links de confirmação e de recuperação.
URL_DO_APP=https://seu-app.vercel.app
# Origem exata permitida no CORS. Sem barra no final. Aceita várias, por vírgula.
CORS_ORIGENS=https://seu-app.vercel.app

# ---------- envio de e-mail ----------
# SMTP_HOST é obrigatório: sem ele o Compose se recusa a subir. Em
# desenvolvimento use "mailpit" (veja o bloco de desenvolvimento no fim).
#
# Nunca rode um SMTP na própria máquina: IP residencial novo cai direto em spam,
# e aí ninguém confirma o cadastro.
#
# BREVO — a escolha para quem ainda não tem domínio.
#   Ele aceita "remetente avulso verificado": você confirma um e-mail que já é
#   seu (o Gmail serve) e passa a enviar para qualquer destinatário. 300/dia de
#   graça, sem prazo de validade.
#     1. Crie a conta em brevo.com
#     2. Senders, Domains & IPs > Senders > Add a sender > confirme no seu e-mail
#     3. SMTP & API > SMTP > gere uma chave
#     4. SMTP_USUARIO = o campo "Login" dessa mesma tela. NÃO é o e-mail da sua
#        conta Brevo — testado, ele é recusado com "5.7.8 Authentication
#        failed". O Brevo emite um login próprio, no formato
#        9xxxxxx001@smtp-brevo.com.
#        SMTP_SENHA   = a chave gerada, e vai no .env.secrets, não aqui
#     5. EMAIL_REMETENTE tem que ser EXATAMENTE o remetente verificado no passo 2
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_AUTH=true
SMTP_TLS=true
EMAIL_REMETENTE=Controle de Despesas <seu-email-verificado@gmail.com>

# Quando você tiver domínio próprio: cadastre-o no Brevo (ele mostra os
# registros SPF e DKIM para pôr no DNS) e troque só o EMAIL_REMETENTE para
# nao-responda@seu-dominio.com.br. Nada mais muda. Entrega melhor e some o
# "enviado via brevo" que alguns clientes mostram.
#
# Alternativa: Resend (smtp.resend.com, porta 587, usuário "resend", senha = a
# API key). Só vale depois do domínio — no plano grátis, sem domínio verificado
# ele entrega apenas no e-mail da sua própria conta.

# ---------- entrar com o Google ----------
# Em branco desliga o botão; o resto do app funciona igual.
# console.cloud.google.com > APIs e Serviços > Credenciais >
#   Criar credenciais > ID do cliente OAuth > Aplicativo da Web
# Em "Origens JavaScript autorizadas" ponha a URL do front
#   (http://localhost:5173 para desenvolvimento).
# Escopos usados: openid, email, profile — não sensíveis, sem revisão do Google.
GOOGLE_CLIENT_ID=

# ---------- desenvolvimento ----------
# Descomente APENAS na sua máquina. Sobe o Mailpit junto e manda os e-mails
# para ele, em http://localhost:8025, sem nada sair para a internet.
# COMPOSE_PROFILES=dev
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_AUTH=false
# SMTP_TLS=false
